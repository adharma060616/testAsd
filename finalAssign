from pyspark.sql import SparkSession
from pyspark.sql.functions import *
from pyspark.sql.window import Window

# ---------------- CONFIG ----------------
ADLS_ACCOUNT = "stcapstone"      # <-- CHANGE THIS TO YOUR STORAGE ACCOUNT
SILVER = f"abfss://silver@{ADLS_ACCOUNT}.dfs.core.windows.net"
GOLD   = f"abfss://gold@{ADLS_ACCOUNT}.dfs.core.windows.net"

spark = SparkSession.builder.getOrCreate()

print("Loading Silver tables...")

# ---------------- LOAD SILVER ----------------
customers   = spark.read.parquet(f"{SILVER}/customers/")
accounts    = spark.read.parquet(f"{SILVER}/accounts/")
trx         = spark.read.parquet(f"{SILVER}/transactions/")
trades      = spark.read.parquet(f"{SILVER}/trades/")
mp          = spark.read.parquet(f"{SILVER}/market_prices/")

# =====================================================================
# 1. DIM DATE
# =====================================================================
print("Building DimDate...")

from datetime import date, timedelta
start = date(2018,1,1)
end   = date(2028,12,31)

calendar_rows = []
d = start
sk = 1
while d <= end:
    calendar_rows.append((
        sk, d, d.day, d.month,
        (d.month-1)//3 + 1, d.year,
        int(d.strftime("%W")),
        1 if d.weekday()>=5 else 0,
        0
    ))
    d += timedelta(days=1)
    sk += 1

DimDate = spark.createDataFrame(calendar_rows,
    "dim_date_sk int, full_date date, day int, month int, quarter int, year int, week int, is_weekend int, is_holiday int"
)

DimDate.write.mode("overwrite").parquet(f"{GOLD}/dim_date/")
print("✔ DimDate ready")

# =====================================================================
# 2. DIM BRANCH
# =====================================================================
print("Building DimBranch...")

DimBranch = (
    customers.select("branch_id","branch_name","city","region","country")
    .dropDuplicates()
    .withColumn("dim_branch_sk", monotonically_increasing_id())
)

DimBranch.write.mode("overwrite").parquet(f"{GOLD}/dim_branch/")
print("✔ DimBranch ready")

# =====================================================================
# 3. DIM INSTRUMENT
# =====================================================================
print("Building DimInstrument...")

DimInstrument = (
    trades.select("ticker","instrument_type","exchange")
    .dropDuplicates()
    .withColumn("dim_instrument_sk", monotonically_increasing_id())
)

DimInstrument.write.mode("overwrite").parquet(f"{GOLD}/dim_instrument/")
print("✔ DimInstrument ready")

# =====================================================================
# 4. DIM PRODUCT
# =====================================================================
print("Building DimProduct...")

DimProduct = spark.createDataFrame([
    (1,"CASA","CASA"),
    (2,"Savings","SAV"),
    (3,"Current","CUR"),
    (4,"Equity","EQ"),
    (5,"Bond","BD"),
    (6,"Derivative","DRV")
], "dim_product_sk int, product_type string, product_code string")

DimProduct.write.mode("overwrite").parquet(f"{GOLD}/dim_product/")
print("✔ DimProduct ready")

# =====================================================================
# 5. DIM CUSTOMER (SCD2)
# =====================================================================
print("Building DimCustomer (SCD2)...")

w = Window.partitionBy("customer_key").orderBy(col("updated_at").asc_nulls_last())

DimCustomer = (
    customers
    .withColumn("eff_from", coalesce("updated_at", current_timestamp()))
    .withColumn("eff_to", lead("updated_at").over(w))
    .withColumn("is_current", when(col("eff_to").isNull(), lit(1)).otherwise(lit(0)))
    .withColumn("dim_customer_sk", monotonically_increasing_id())
)

DimCustomer.write.mode("overwrite").parquet(f"{GOLD}/dim_customer/")
print("✔ DimCustomer ready")

# =====================================================================
# 6. DIM ACCOUNT
# =====================================================================
print("Building DimAccount...")

DimAccount = (
    accounts
    .withColumn("balance_band",
        when(col("balance") < 1000, "<1k")
        .when(col("balance") < 10000, "1k-10k")
        .when(col("balance") < 100000, "10k-100k")
        .otherwise("100k+")
    )
    .withColumn("dim_account_sk", monotonically_increasing_id())
)

DimAccount.write.mode("overwrite").parquet(f"{GOLD}/dim_account/")
print("✔ DimAccount ready")

# =====================================================================
# 7. FACT RETAIL TRANSACTIONS
# =====================================================================
print("Building FactRetailTransactions...")

# Step 1: Join trx → customers to get branch_id
trx_w_branch = trx.alias("t") \
    .join(customers.select("customer_key","branch_id"), "customer_key", "left")

# Step 2: Join branch_id → DimBranch
trx_w_dimbranch = trx_w_branch.join(DimBranch, "branch_id", "left")

# Step 3: Join trx → DimCustomer
trx_final = trx_w_dimbranch.join(
    DimCustomer.select("customer_key","dim_customer_sk"),
    "customer_key",
    "left"
).withColumn("dim_date_sk", col("txn_date"))

# Step 4: Final selection (ONLY fields present in Silver)
FactRetail = trx_final.select(
    "customer_key",
    "dim_customer_sk",
    "dim_branch_sk",
    col("t.account_ref").alias("account_ref"),
    col("t.txn_id").alias("txn_id"),
    col("t.amount").alias("amount"),
    col("t.amount_usd").alias("amount_usd"),
    col("t.channel").alias("channel"),
    col("t.status").alias("status"),
    col("t.txn_type").alias("txn_type"),
    col("t.processing_time_sec").alias("processing_time_sec"),
    col("t.txn_timestamp").alias("txn_timestamp"),
    "dim_date_sk"
)

FactRetail.write.mode("overwrite").parquet(f"{GOLD}/fact_retail_transactions/")
print("✔ FactRetail ready")

# =====================================================================
# 8. FACT INVESTMENT TRADES
# =====================================================================
print("Building FactInvestmentTrades...")

FactTrades = (
    trades.alias("tr")
    .join(DimCustomer.select("customer_key","dim_customer_sk"), "customer_key", "left")
    .join(DimInstrument, "ticker", "left")
    .withColumn("dim_date_sk", to_date("trade_timestamp"))
    .select(
        "customer_key",
        "dim_customer_sk",
        "dim_instrument_sk",
        "trade_id",
        "quantity",
        "price",
        "trade_value",
        "realized_pnl",
        "unrealized_pnl",
        "total_pnl",
        "commission",
        "trade_side",
        "status",
        col("trade_timestamp").alias("trade_timestamp"),
        "dim_date_sk"
    )
)

FactTrades.write.mode("overwrite").parquet(f"{GOLD}/fact_investment_trades/")
print("✔ FactInvestmentTrades ready")

# =====================================================================
# 9. FACT PORTFOLIO HOLDINGS
# =====================================================================
print("Building FactPortfolioHoldings...")

latest_price = (
    mp.groupBy("ticker")
    .agg(max("price_date").alias("latest_date"))
    .join(mp, (mp.ticker == col("ticker")) & (mp.price_date == col("latest_date")))
    .select(mp["ticker"], mp["close_price"])
)

buy_trades = (
    trades.filter(col("trade_side")=="BUY")
    .groupBy("customer_key","ticker")
    .agg(
        sum("quantity").alias("units_held"),
        sum(col("quantity") * col("price")).alias("cost_basis_total")
    )
)

holdings = (
    buy_trades
    .join(latest_price, "ticker", "left")
    .withColumn("market_value_usd", col("units_held") * col("close_price"))
    .join(DimInstrument, "ticker", "left")
    .join(DimCustomer.select("customer_key","dim_customer_sk"), "customer_key", "left")
    .withColumn("dim_date_sk", lit(None).cast("int"))
    .select(
        "customer_key",
        "dim_customer_sk",
        "dim_instrument_sk",
        "dim_date_sk",
        "units_held",
        "market_value_usd",
        "cost_basis_total"
    )
)

holdings.write.mode("overwrite").parquet(f"{GOLD}/fact_portfolio_holdings/")
print("✔ FactPortfolioHoldings ready")

# =====================================================================
# 10. FACT DAILY PNL
# =====================================================================
print("Building FactDailyPnL...")

daily = (
    trades
    .withColumn("trade_date", to_date("trade_timestamp"))
    .groupBy("customer_key","trade_date")
    .agg(
        sum("realized_pnl").alias("daily_realized_pnl"),
        sum("unrealized_pnl").alias("daily_unrealized_pnl")
    )
)

w_daily = (
    Window.partitionBy("customer_key")
    .orderBy("trade_date")
    .rowsBetween(Window.unboundedPreceding, Window.currentRow)
)

daily = (
    daily
    .withColumn("cumulative_pnl",
        sum(col("daily_realized_pnl") + col("daily_unrealized_pnl")).over(w_daily)
    )
    .join(DimCustomer.select("customer_key","dim_customer_sk"), "customer_key", "left")
    .withColumn("dim_date_sk", col("trade_date"))
    .select(
        "customer_key",
        "dim_customer_sk",
        "dim_date_sk",
        "daily_realized_pnl",
        "daily_unrealized_pnl",
        "cumulative_pnl"
    )
)

daily.write.mode("overwrite").parquet(f"{GOLD}/fact_daily_pnl/")
print("✔ FactDailyPnL ready")

print("================================================")
print("   GOLD LAYER BUILD SUCCESSFULLY COMPLETED      ")
print("================================================")
